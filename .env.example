# Copy to .env.local and adjust. Validated by src/config/env.ts at startup.

# Public app URL (used for absolute links, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL the Axios client points at.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Toggle API mocking ("true" / "false").
NEXT_PUBLIC_ENABLE_API_MOCKING=false
